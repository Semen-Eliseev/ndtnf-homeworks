<form method="POST" enctype="multipart/form-data">
    <div class="mb-3">
        <label for="title" class="form-label">Название</label>
        <input
            type="text"
            class="form-control"
            id="title"
            name="title"
            required
        >
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Описание</label>
        <textarea
            class="form-control"
            id="description"
            name="description"
        ></textarea>
    </div>

    <div class="mb-3">
        <label for="authors" class="form-label">Авторы</label>
        <input
            type="text"
            class="form-control"
            id="authors"
            name="authors"
        >
    </div>

     <div class="form-check mb-3">
        <input
            class="form-check-input"
            type="checkbox"
            id="favorite"
            name="favorite"
        >
        <label class="form-check-label" for="favorite">
            Избранная
        </label>
    </div>

    <div class="mb-3">
        <label for="fileBook" class="form-label">Файл книги</label>
        <input
            type="file"
            class="form-control"
            id="fileBook"
            name="fileBook"
            required
        >
    </div>




    <button type="submit" class="btn btn-primary">
        Сохранить
    </button>
</form>